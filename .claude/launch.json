{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "saldesk-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "backend",
      "port": 3001
    },
    {
      "name": "saldesk-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "saldesk-website",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "4173", "."],
      "cwd": "website",
      "port": 4173
    }
  ]
}
